# Open Transit RT OCI/OCL-style reference deployment environment
# This guide is documentation for reproducing a self-hosted deployment pattern. It is not evidence that a deployment was run, accepted, compliant, agency-approved, or production-ready.
#
# Copy this file to a private operator-owned path such as:
#   /opt/open-transit-rt/env
#   /opt/open-transit-rt/ops/pilot-ops.env
#
# Keep real files mode 0600 and never commit live values.
# Every secret below must be replaced with a deployment-generated value.
# Do not paste historical pilot hosts, real DB URLs, admin tokens, webhook URLs,
# or evidence values into this example.

###############################################################################
# service runtime
###############################################################################

APP_ENV=production
BIND_ADDR=127.0.0.1
AGENCY_ID=replace-with-agency-id
PUBLICATION_ENVIRONMENT=reference
METRICS_ENABLED=false
LOG_LEVEL=info

###############################################################################
# public URL/feed metadata
###############################################################################

PUBLIC_BASE_URL=https://feeds.example.org
FEED_BASE_URL=https://feeds.example.org/public
SCHEDULE_FEED_URL=https://feeds.example.org/public/gtfs/schedule.zip
REALTIME_VALIDATION_BASE_URL=https://feeds.example.org/public
VEHICLE_POSITIONS_FEED_URL=https://feeds.example.org/public/gtfsrt/vehicle_positions.pb
TRIP_UPDATES_FEED_URL=https://feeds.example.org/public/gtfsrt/trip_updates.pb
ALERTS_FEED_URL=https://feeds.example.org/public/gtfsrt/alerts.pb
TECHNICAL_CONTACT_EMAIL=transit-data@example.org
FEED_LICENSE_NAME=replace-with-open-license-name
FEED_LICENSE_URL=https://example.org/replace-with-license-url

###############################################################################
# admin/auth secrets
###############################################################################

ADMIN_JWT_SECRET=replace-with-generated-secret
ADMIN_JWT_OLD_SECRETS=
ADMIN_JWT_ISSUER=open-transit-rt-reference
ADMIN_JWT_AUDIENCE=open-transit-rt-admin
ADMIN_JWT_TTL=8h
CSRF_SECRET=replace-with-generated-secret

###############################################################################
# device token secret
###############################################################################

DEVICE_TOKEN_PEPPER=replace-with-generated-secret

###############################################################################
# validator tooling
###############################################################################

VALIDATOR_TOOLING_MODE=pinned
GTFS_VALIDATOR_PATH=/opt/open-transit-rt/.cache/validators/gtfs-validator-7.1.0-cli.jar
GTFS_VALIDATOR_VERSION=v7.1.0
GTFS_RT_VALIDATOR_PATH=/opt/open-transit-rt/.cache/validators/gtfs-rt-validator-wrapper.sh
GTFS_RT_VALIDATOR_VERSION=replace-with-pinned-gtfs-rt-validator-digest
GTFS_RT_VALIDATOR_READY_TIMEOUT_SECONDS=60
JAVA_BINARY=/usr/bin/java

###############################################################################
# database
###############################################################################

DATABASE_URL=replace-with-database-url-containing-generated-secret
MIGRATIONS_DIR=/opt/open-transit-rt/app/db/migrations
RESTORE_DATABASE_URL=replace-with-restore-database-url-containing-generated-secret

###############################################################################
# pilot-ops helpers
###############################################################################

ENVIRONMENT_NAME=replace-with-environment-name
EVIDENCE_OUTPUT_DIR=/opt/open-transit-rt/evidence/replace-with-utc-date
ADMIN_BASE_URL=http://127.0.0.1:8081
ADMIN_TOKEN=replace-with-generated-secret

###############################################################################
# backup/restore
###############################################################################

BACKUP_DIR=/opt/open-transit-rt/backups
BACKUP_RETENTION_DAYS=7
RESTORE_BACKUP_FILE=/opt/open-transit-rt/backups/replace-with-backup-file.dump

###############################################################################
# monitoring/notification placeholders
###############################################################################

NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_TO=replace-with-notification-email-or-empty
CAPTURE_DATE_UTC=replace-with-utc-date
